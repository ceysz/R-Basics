m1 <- lmer(SelfEsteem ~ PerceivedSupport_pc + (1|ID), data = Diary)
m2 <- lmer(LifeSatisfaction ~ PerceivedSupport_pc + (1|ID), data = Diary)
m3 <- lmer(PositiveAffect ~ PerceivedSupport_pc + (1|ID), data = Diary)
m4 <- lmer(SocialAnxiety ~ PerceivedSupport_pc + (1|ID), data = Diary)
m5 <- lmer(NegativeAffect ~ PerceivedSupport_pc + (1|ID), data = Diary)
m6 <- lmer(Depression ~ PerceivedSupport_pc + (1|ID), data = Diary)

# Extract fixed effects and CI for each model
extract_results <- function(model, model_name) {
  fixed_effects <- summary(model)$coefficients
  conf_intervals <- confint(model, method = "Wald", level = 0.95)
  
  results <- data.frame(
    Predictor = rownames(fixed_effects),
    Beta = sprintf("%.2f", round(fixed_effects[, "Estimate"], 2)),
    CI = paste0("[", 
                sprintf("%.2f", round(conf_intervals[rownames(fixed_effects), "2.5 %"], 2)),
                ", ", 
                sprintf("%.2f", round(conf_intervals[rownames(fixed_effects), "97.5 %"], 2)),
                "]"),
    p_value = fixed_effects[, "Pr(>|t|)"],
    stringsAsFactors = FALSE
  )
  
  results$Model <- model_name
  return(results)
}

# Extract results for linear models
m1_results <- extract_results(m1, "SelfEsteem")
m2_results <- extract_results(m2, "LifeSatisfaction")
m3_results <- extract_results(m3, "PositiveAffect")
m4_results <- extract_results(m4, "SocialAnxiety")
m5_results <- extract_results(m5, "NegativeAffect")
m6_results <- extract_results(m6, "Depression")

# Combine all results
all_results <- bind_rows(
  m1_results, m2_results, m3_results, m4_results, m5_results, m6_results
)

# Replace NAs with "999" (temporarily replace NAs with "999" to avoid formatting issues during table reshaping, then we will remove them for clean display) 
all_results[is.na(all_results)] <- "999"

# Add significance stars
all_results <- all_results %>%
  mutate(
    Beta = case_when(
      p_value < 0.001 ~ paste0(Beta, "***"),
      p_value < 0.01 ~ paste0(Beta, "**"),
      p_value < 0.05 ~ paste0(Beta, "*"),
      TRUE ~ Beta
    )
  )
# Combine beta and CI values
all_results <- all_results %>%
  mutate(
    Beta_CI = paste0(Beta, "\n", CI)
  )

# Prepare table data
table_data <- all_results %>%
  select(Predictor, Model, Beta_CI) %>%
  pivot_wider(names_from = Model, values_from = Beta_CI, values_fill = "")

# Delete "999" from the table
table_data <- table_data %>%
  mutate(across(everything(), ~ gsub("999", "", .)))

# Create the table
Table_rq1_nonbinary <- flextable(table_data) %>%
  theme_booktabs() %>%
  set_header_labels(
    Predictor = "Predictors",
    SelfEsteem = "Self-Esteem",
    LifeSatisfaction = "Life Satisfaction",
    PositiveAffect = "Positive Affect",
    SocialAnxiety = "Social Anxiety",
    NegativeAffect = "Negative Affect",
    Depression = "Depression"
  ) %>%
  add_header(
    top = TRUE,
    Predictor = "",
    SelfEsteem = "DV: SelfEsteem",
    LifeSatisfaction = "DV: LifeSatisfaction",
    PositiveAffect = "DV: PositiveAffect",
    SocialAnxiety = "DV: SocialAnxiety",
    NegativeAffect = "DV: NegativeAffect",
    Depression = "DV: Depression"
  ) %>%
  merge_h(part = "header") %>%
  align(align = "left", part = "header", j = 1) %>%
  align(align = "center", part = "header", j = 2:7) %>%
  align(align = "left", part = "body", j = 1) %>%
  align(align = "center", part = "body", j = 2:7) %>%
  valign(valign = "center", part = "body") %>%
  set_caption(
    as_paragraph(
      as_chunk("Table X. Separate Models for Psychological Outcomes", 
               props = fp_text_default(font.size = 11, bold = TRUE))
    ),
    align_with_table = FALSE
  ) %>%
  add_footer_lines("* p < .05, ** p < .01, *** p < .001") %>%
  font(fontname = "Times New Roman", part = "all") %>%
  autofit()

